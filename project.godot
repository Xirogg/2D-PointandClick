; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Unsequenced"
run/main_scene="res://Scenes/GUI/Menus/main_menu.tscn"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
config/icon="uid://18r0akt250ui"

[autoload]

GameSettings="*res://Scripts/Globals/GameSettings.gd"
Global="*res://Scripts/Globals/Global.gd"
ItemLogic="*res://Scripts/Globals/ItemLogic.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
Lexicon="*uid://cox207qi7j4f6"
AudioManager="*res://Scripts/Globals/AudioManager.gd"
MusicManager="*res://Scripts/Globals/MusicManager.gd"

[dialogue_manager]

runtime/balloon_path="res://Scenes/GUI/dialogue_balloon.tscn"
runtime/advanced/uses_dotnet=true

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
mouse_cursor/custom_image="uid://ci8pvew8yehi1"

[dotnet]

project/assembly_name="Point and Click Tech Stuff"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "purple",
"res://Dialogue/": "teal",
"res://Modules/": "gray",
"res://Ressources/": "red",
"res://Scenes/": "yellow",
"res://Scripts/": "blue"
}

[global_group]

Player="Player Gruppe nur für Player"
camera_bounds=""

[gui]

theme/custom_font="uid://bfqdqxvalq65a"

